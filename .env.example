# MITRA Environment Variables
# Copy this file to .env.local and fill in your actual credentials
# DO NOT commit .env.local to version control

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase (Server-side only - keep secret)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini (Server-side only - keep secret)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Resend (Server-side only - keep secret)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=your-email@resend.com

# Environment
NODE_ENV=development
